# Copy this file to .triage.env and fill in your values.
# .triage.env is git-ignored and never committed.

# ---------------------------------------------------------------------------
# Local / Single-User Mode (CLI and local `3riage ui` / `python app.py`)
# ---------------------------------------------------------------------------

# Optional if `gh auth login` is configured; auto-detected from token via `viewer { login }`
# GITHUB_USERNAME=your_username_here

# Optional if `gh auth login` is configured locally
# Scopes needed (classic token): repo (read), read:org, read:user
# Prefer a fine-grained read-only token scoped to repos you care about.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: include draft PRs in triage output (default: false)
TRIAGE_INCLUDE_DRAFTS=false

# Optional: skip comments from bot accounts (default: true)
TRIAGE_IGNORE_BOTS=true

# Optional: comma-separated list of repos to skip entirely
# TRIAGE_IGNORE_REPOS=owner/spam-repo,owner/another

# Optional: comma-separated list of repos to limit triage to
# TRIAGE_ONLY_REPOS=drips/frontend,drips/contracts

# Optional: ignore activity younger than N hours (reduces noise from rapid-fire comments, default: 0)
TRIAGE_MIN_AGE_HOURS=0

# ---------------------------------------------------------------------------
# Public Multi-User Web Mode (GitHub App / OAuth on Vercel or self-hosted server)
# ---------------------------------------------------------------------------

# GitHub App (recommended, zero repo permissions = read-only public access)
# or GitHub OAuth App credentials:
# GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random high-entropy secret used to encrypt HttpOnly session cookies (required on Vercel)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_SECRET=change_me_to_a_long_random_secret

# Optional: override OAuth callback URL (defaults to <scheme>://<host>/api/auth/callback)
# GITHUB_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Optional: only needed for classic OAuth Apps if you want scopes beyond public read-only
# Leave empty for GitHub Apps (GitHub Apps ignore OAuth scopes)
# GITHUB_OAUTH_SCOPE=
