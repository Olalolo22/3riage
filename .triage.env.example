# Copy this file to .triage.env and fill in your values.
# .triage.env is git-ignored and never committed.

# Required: your GitHub username
GITHUB_USERNAME=your_username_here

# Required: GitHub token (read-only classic token is fine)
# Scopes needed: repo (read), read:org, read:user
# Prefer a fine-grained token scoped to repos you care about.
# If fine-grained can't see cross-org repos, fall back to a classic token.
# Never use a token with write scopes — the fork action uses `gh` CLI separately.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: include draft PRs in triage output (default: false)
TRIAGE_INCLUDE_DRAFTS=false

# Optional: skip comments from bot accounts (default: true)
TRIAGE_IGNORE_BOTS=true

# Optional: comma-separated list of repos to skip entirely
# TRIAGE_IGNORE_REPOS=owner/spam-repo,owner/another

# Optional: comma-separated list of repos to limit triage to
# TRIAGE_ONLY_REPOS=drips/frontend,drips/contracts

# Optional: ignore activity younger than N hours (reduces noise from rapid-fire comments, default: 0)
TRIAGE_MIN_AGE_HOURS=0
